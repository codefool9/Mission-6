@model Movie

<h1>Add a Movie</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="CategoryId">CategoryId:</label>
        <input asp-for="CategoryId" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Title">Title:</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Year">Year:</label>
        <input asp-for="Year" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Director">Director:</label>
        <input asp-for="Director" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="Rating">Rating:</label>
        <select asp-for="Rating" class="form-control" required>
            <option value="">Select a Rating</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Edited">Edited:</label>
        <select asp-for="Edited" class="form-control">
            <option value="false">No</option>
            <option value="true">Yes</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="LentTo">Lent To:</label>
        <input asp-for="LentTo" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Notes">Notes:</label>
        <textarea asp-for="Notes" class="form-control" maxlength="25"></textarea>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Submit Movie</button>
</form>